# Sao chép thành .env rồi điền giá trị.
# Chuỗi ngẫu nhiên dài, ví dụ: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# online-or-name-mismatch (mặc định) hoặc strict
DUPLICATE_POLICY=online-or-name-mismatch
ADMIN_CAN_SIT_ANYWHERE=false
# Mật khẩu ban đầu của tài khoản admin, chỉ dùng để tạo tài khoản lần đầu (đổi ngay sau khi đăng nhập).
ADMIN_INITIAL_PASSWORD=
PORT=5310
# DB_PATH=data/sysone.db
# COOKIE_SECURE=true   (bật khi chạy sau HTTPS)

# Tải model nhân vật từ Sketchfab (scripts/fetch-sketchfab.mjs) — sketchfab.com → Settings → Password & API
SKETCHFAB_TOKEN=
