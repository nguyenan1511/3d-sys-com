# Sao chép thành .env rồi điền giá trị.
# Chuỗi ngẫu nhiên dài, ví dụ: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# online-or-name-mismatch (mặc định) hoặc strict
DUPLICATE_POLICY=online-or-name-mismatch
ADMIN_CAN_SIT_ANYWHERE=false
# Mật khẩu ban đầu của tài khoản admin, chỉ dùng để tạo tài khoản lần đầu (đổi ngay sau khi đăng nhập).
ADMIN_INITIAL_PASSWORD=
PORT=5310
# DB_PATH=data/sysone.db
# COOKIE_SECURE=true   (bật khi chạy sau HTTPS)

# Tải model nhân vật từ Sketchfab (scripts/fetch-sketchfab.mjs) — sketchfab.com → Settings → Password & API
SKETCHFAB_TOKEN=

# (tuỳ chọn) Gợi ý bài karaoke qua YouTube Data API v3 (Google Cloud Console → bật "YouTube Data API v3" → tạo API key).
# Bỏ trống: server đọc trang tìm kiếm công khai của YouTube thay thế. Mỗi lần tìm ~101 đơn vị quota (mặc định 10.000/ngày).
YOUTUBE_API_KEY=

# MongoDB (Atlas M0 miễn phí): nơi lưu dữ liệu — mỗi bảng một collection (employees, seats, attendance, chat_messages,
# audit…), xem / tìm được trong Atlas Data Explorer. Bắt buộc khi server không có ổ đĩa (Render miễn phí).
# Không đặt: dữ liệu lưu ở file JSON cạnh DB_PATH (máy dev); lần đầu tự chuyển database SQLite cũ (DB_PATH .db) sang.
MONGODB_URI=
# MONGODB_DB=sysone

# Giới hạn tải (gói Render free 0,1 CPU): số nhân viên online tối đa cùng lúc — người tiếp theo thấy màn chờ "Văn phòng đang
# quá tải" và tự vào khi có chỗ (ai chờ trước vào trước; CEO không tính). Thử tải 19/11/2026: 80 người dùng ~2% CPU một nhân,
# ~4,4 KB/s mỗi người khi chia 3 tầng.
# MAX_ONLINE=80
# Dung lượng tối đa cho mọi file tải lên (tài liệu họp / dự án, ảnh bảng tin, ảnh bảng vẽ) — Atlas M0 có 512 MB cho cả database.
# FILES_QUOTA_MB=350
# Giữ lịch sử: chat (ngày), nhật ký thao tác (ngày) — cũ hơn tự xoá mỗi ngày.
# CHAT_KEEP_DAYS=90
# AUDIT_KEEP_DAYS=365
