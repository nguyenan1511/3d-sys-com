# Sao chép thành .env rồi điền giá trị.
# Chuỗi ngẫu nhiên dài, ví dụ: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# online-or-name-mismatch (mặc định) hoặc strict
DUPLICATE_POLICY=online-or-name-mismatch
ADMIN_CAN_SIT_ANYWHERE=false
# Mật khẩu ban đầu của tài khoản admin, chỉ dùng để tạo tài khoản lần đầu (đổi ngay sau khi đăng nhập).
ADMIN_INITIAL_PASSWORD=
PORT=5310
# DB_PATH=data/sysone.db
# COOKIE_SECURE=true   (bật khi chạy sau HTTPS)

# Tải model nhân vật từ Sketchfab (scripts/fetch-sketchfab.mjs) — sketchfab.com → Settings → Password & API
SKETCHFAB_TOKEN=

# (tuỳ chọn) Gợi ý bài karaoke qua YouTube Data API v3 (Google Cloud Console → bật "YouTube Data API v3" → tạo API key).
# Bỏ trống: server đọc trang tìm kiếm công khai của YouTube thay thế. Mỗi lần tìm ~101 đơn vị quota (mặc định 10.000/ngày).
YOUTUBE_API_KEY=

# (Tuỳ chọn) Lưu dữ liệu lên MongoDB (Atlas M0 miễn phí) để không mất khi server khởi động lại không có ổ đĩa (Render free).
# Chỉ chạy khi NODE_ENV=production (máy dev: thêm MONGO_SYNC=1 nếu muốn thử — cẩn thận đè dữ liệu thật, nên đổi MONGODB_SNAPSHOT_ID).
MONGODB_URI=
# MONGODB_DB=sysone
# MONGODB_SNAPSHOT_ID=sysone
